# Copy this file to .env for local development.
# Never commit a real .env file — it is already in .gitignore.
#
# In deployed environments (AWS Lambda), these same names are set as
# Lambda environment variables by infrastructure/template.yaml, sourced
# from SAM parameters / AWS SSM / Secrets Manager. Nothing here should
# ever be hard-coded into application code.

# ---------------------------------------------------------------------------
# AWS / DynamoDB
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Leave DYNAMODB_ENDPOINT_URL unset to use real AWS DynamoDB.
# Set it (e.g. http://localhost:8000) to point at DynamoDB Local for
# offline development. See docs/deployment.md "Local development".
DYNAMODB_ENDPOINT_URL=

ZONES_TABLE=AgriIot-Zones
READINGS_TABLE=AgriIot-SensorReadings
WEATHER_CACHE_TABLE=AgriIot-WeatherForecastCache
ALERTS_TABLE=AgriIot-Alerts
IRRIGATION_DECISIONS_TABLE=AgriIot-IrrigationDecisions
ACTIVITY_TABLE=AgriIot-ApiActivity

# ---------------------------------------------------------------------------
# Amazon SNS (alerting)
# ---------------------------------------------------------------------------
# ARN of the SNS topic alerts are published to (created by the SAM stack).
SNS_TOPIC_ARN=

# Optional: comma-separated E.164 phone numbers (e.g. +15551234567) for
# direct SMS publishing IN ADDITION TO the topic. Leave blank to rely on
# topic subscribers only. Never commit real phone numbers — use
# AWS SSM Parameter Store / Secrets Manager in deployed environments.
ALERT_SMS_PHONE_NUMBERS=

# ---------------------------------------------------------------------------
# Email alerts (Gmail SMTP)
# ---------------------------------------------------------------------------
# Sender account. SMTP_APP_PASSWORD is a Google App Password, NOT your normal
# password: Google Account → Security → 2-Step Verification → App passwords.
# Leave blank to simulate emails (printed to the console, nothing sent).
# People who should receive alerts register on the dashboard's Notifications page.
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=AgriIoT Alerts

# ---------------------------------------------------------------------------
# Weather provider
# ---------------------------------------------------------------------------
# "openweather" (default) or "tomorrowio"
WEATHER_PROVIDER=openweather

# Required if WEATHER_PROVIDER=openweather. Needs a One Call API 3.0
# subscription (OpenWeatherMap's free tier covers up to 1,000 calls/day).
# See docs/architecture.md for details and provider-switch instructions.
OPENWEATHER_API_KEY=

# Required if WEATHER_PROVIDER=tomorrowio
TOMORROWIO_API_KEY=

FORECAST_DAYS=7
WEATHER_HTTP_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Irrigation decision engine thresholds (see services/irrigation_engine.py)
# ---------------------------------------------------------------------------
# Rain is considered "significant" (enough to hold off irrigation) when the
# forecast rainfall over the next FORECAST_WINDOW_DAYS_FOR_RAIN days is at
# least RAIN_SIGNIFICANT_MM *and* the probability is at least
# RAIN_PROBABILITY_THRESHOLD_PCT.
RAIN_SIGNIFICANT_MM=5.0
RAIN_PROBABILITY_THRESHOLD_PCT=50
HIGH_TEMPERATURE_C=32
FORECAST_WINDOW_DAYS_FOR_RAIN=2

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# Minimum minutes between repeat alerts for the same zone (deduplication).
ALERT_COOLDOWN_MINUTES=360

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Set to your deployed frontend origin in production, e.g.
# https://dashboard.example.com — avoid "*" outside local development.
CORS_ALLOWED_ORIGIN=*

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod
