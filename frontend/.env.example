# Local development — point at localhost or a deployed API Gateway.
# Copy this to .env.local and fill in your values. Never commit real .env files.

# For local testing against a mock/offline API:
VITE_API_BASE_URL=http://localhost:3001

# For a deployed AWS API Gateway:
# VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod
